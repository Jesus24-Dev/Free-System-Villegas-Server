// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  ATHLETE
  COACH
  ADMIN
}

enum Fighting_Mode {
  POINT_FIGHTING
  KICK_LIGHT 
  LIGHT_CONTACT
  FULL_CONTACT
  LOW_KICK
  K1
  BOXING
}

enum Fighting_Category {
  CH
  YC
  OC
  J
  S
  M
}

enum Gender {
  MALE
  FEMALE
}

enum States {
  AMAZONAS
  ANZOATEGUI
  APURE
  ARAGUA
  BARINAS
  BOLIVAR
  CARABOBO
  COJEDES
  DELTA_AMACURO
  DISTRITO_CAPITAL
  FALCON
  GUARICO
  LARA
  LA_GUAIRA
  MERIDA
  MIRANDA
  MONAGAS
  NUEVA_ESPARTA
  PORTUGUESA
  SUCRE
  TACHIRA
  TRUJILLO
  YARACUY
  ZULIA
}

model User {
  id String @id @default(uuid())
  email String @unique
  password String
  role Roles[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  person Person? @relation(fields: [person_id], references: [id])
  person_id String? @unique
}

model Person {
  id String @id @default(uuid())
  dni String @unique
  name String
  surname String
  birthday DateTime
  gender Gender
  status Boolean @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User?
  coach Coach?
  athlete Athlete?
}

model Gym {
  id String @id @default(uuid())
  name String
  address String
  state States
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  coaches Coach[]
  athletes Athlete[]
}

model Coach {
  id String @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  person Person @relation(fields: [person_id], references: [id])
  person_id String @unique

  gym Gym @relation(fields: [gym_id], references: [id])
  gym_id String
}

model Athlete {
  id String @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  person Person @relation(fields: [person_id], references: [id])
  person_id String @unique

  gym Gym @relation(fields: [gym_id], references: [id])
  gym_id String
}

model Fighting_Weights {
  id String @id @default(uuid())
  mode Fighting_Mode
  category Fighting_Category
  gender Gender
  weights Int[]
}