// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  ATHLETE
  COACH
  ADMIN
}

enum Fighting_Mode {
  POINT_FIGHTING
  KICK_LIGHT 
  LIGHT_CONTACT
  FULL_CONTACT
  LOW_KICK
  K1
  BOXING
}

enum Fighting_Category {
  CH
  YC
  OC
  J
  S
  M
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id String @id @default(uuid())
  email String @unique
  password String
  role Roles[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  info User_info?
}

model User_info {
  id String @id @default(uuid())
  dni String @unique
  name String
  surname String
  birthday DateTime
  status Boolean

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt


  user User @relation(fields: [user_id], references: [id])
  user_id String @unique
}

model Fighting_Weights {
  id String @id @default(uuid())
  mode Fighting_Mode
  category Fighting_Category
  gender Gender
  weights Int[]
}