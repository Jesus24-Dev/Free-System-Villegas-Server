// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

//Roles permitidos en la aplicacion. Cada uno tiene distintas funcionalidades.
enum Roles {
  ATHLETE
  COACH
  ADMIN
}

// Estilos de pelea WAKO y posibilidad de agregar boxeo
enum FightingMode {
  POINT_FIGHTING
  KICK_LIGHT 
  LIGHT_CONTACT
  FULL_CONTACT
  LOW_KICK
  K1
  BOXING
}

// Cateogria por edad WAKO
enum FightingCategory {
  CH
  YC
  OC
  J
  S
  M
}

// Genero para usuarios y competencias
enum Gender {
  MALE
  FEMALE
}

// Estados de Venezuela
enum States {
  AMAZONAS
  ANZOATEGUI
  APURE
  ARAGUA
  BARINAS
  BOLIVAR
  CARABOBO
  COJEDES
  DELTA_AMACURO
  DISTRITO_CAPITAL
  FALCON
  GUARICO
  LARA
  LA_GUAIRA
  MERIDA
  MIRANDA
  MONAGAS
  NUEVA_ESPARTA
  PORTUGUESA
  SUCRE
  TACHIRA
  TRUJILLO
  YARACUY
  ZULIA
}

enum CompetitionStatus {
  DRAFT
  OPEN
  CLOSED
  FINISHED
}

// Modelo usuario. Utilizado para autenticacion y autorizacion del sistema. Crea la cuenta
model User {
  id String @id @default(uuid())
  email String @unique
  password String
  role Roles[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?

  person Person @relation(fields: [person_id], references: [id])
  person_id String @unique

  @@index([deleted_at])
}

// Modelo person se encarga de los datos personales del usuario. Encargada de gestionar las entidades de rol 
// y perfiles de usuario
model Person {
  id String @id @default(uuid())
  dni String @unique
  name String
  surname String
  birthday DateTime
  gender Gender
  status Boolean @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?

  user User?
  coach Coach?
  athlete Athlete?

  @@index([deleted_at])
}

// Modelo Gym encargado de la creacion y gestion de gimnasios del sistema. 
model Gym {
  id String @id @default(uuid())
  name String @unique
  address String
  state States
  monthly_payment Float
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?
  coach_owner Coach @relation("GymOwner", fields: [owner_id], references: [id])
  owner_id String @unique

  coaches Coach[]
  athletes Athlete[]
  payments GymPayment[] @relation("GymPayment")
  pago_movil PagoMovilFields[] @relation("GymDataToPay")

  @@index([deleted_at])
}

// Modelo Coach para tener registro de coach. Permite crear gimnasios y gestionarlos, junto a la gestion de atletas.
model Coach {
  id String @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?

  gym_owned Gym? @relation("GymOwner")

  person Person @relation(fields: [person_id], references: [id])
  person_id String @unique

  gym Gym? @relation(fields: [gym_id], references: [id])
  gym_id String?

  @@index([gym_id])
  @@index([deleted_at])
}

// Modelo atleta para los atletas en los gimnasios. Pueden participar en competencia
model Athlete {
  id String @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?

  person Person @relation(fields: [person_id], references: [id])
  person_id String @unique

  gym Gym? @relation(fields: [gym_id], references: [id])
  gym_id String?

  registrations CompetitionRegistration[] @relation("AthleteRegistrations")
  payments_gym GymPayment[] @relation("AthleteGymPayment")

  @@index([gym_id])
  @@index([deleted_at])
}

// Tabla de pesos WAKO por categoria, modalidad y genero. Tabla rellenada por seeder.
model FightingWeights {
  id String @id @default(uuid())

  mode FightingMode
  category FightingCategory
  gender Gender

  weight Float

  @@index([mode, category, gender, weight])
}

// Modelo de competencia. Los administradores crean la competencia y los coaches pueden registrar a sus alumnos.

model Competition {
  id String @id @default(uuid())
  name String @unique
  description String?
  logo_url String?
  location String
  inscription_begin_at DateTime
  inscription_end_at DateTime
  status CompetitionStatus
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?

  competition_division CompetitionDivision[] @relation("FightModeForAthletes")

  @@index([status])
  @@index([deleted_at])
}

// Modelo para guardar el atleta registrado por competencia.
model CompetitionRegistration {
  id String @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?

  athlete Athlete @relation("AthleteRegistrations", fields: [athlete_id], references: [id])
  athlete_id String

  division CompetitionDivision @relation("AthleteFightModes",fields: [division_id], references: [id])
  division_id String

  @@unique([athlete_id, division_id])
  @@index([division_id])
  @@index([deleted_at])
}

// Modelo fight mode por si algun atleta desea registrar mas de una modalidad.
model CompetitionDivision {
  id String @id @default(uuid())

  mode FightingMode
  category FightingCategory
  gender Gender
  weight Float
  
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?

  competition Competition @relation("FightModeForAthletes", fields: [competition_id], references: [id])
  competition_id String 

  registrations CompetitionRegistration[] @relation("AthleteFightModes")

  @@unique([competition_id, mode, category, gender, weight])
  @@index([deleted_at])
}

// Modelo para gestionar los pagos del gimnasio y mensualidades. 

model GymPayment {
  id String @id @default(uuid())
  day_payed DateTime
  amount Float
  evidence_url String?
  payment_reference String @unique
  isConfirmed Boolean @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?

  athlete Athlete @relation("AthleteGymPayment", fields: [athlete_id], references: [id])
  athlete_id String

  gym Gym @relation("GymPayment", fields: [gym_id], references: [id])
  gym_id String

  @@index([athlete_id])
  @@index([gym_id])
  @@index([deleted_at])
}

model PagoMovilFields {
  id String @id @default(uuid())
  bank_to_pay String
  dni String
  phone String
  deleted_at DateTime?

  gym Gym @relation("GymDataToPay", fields: [gym_id], references: [id])
  gym_id String

  @@unique([bank_to_pay, dni, phone])
  @@index([gym_id])
  @@index([deleted_at])
}